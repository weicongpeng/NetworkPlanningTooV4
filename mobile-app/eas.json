{
  "cli": {
    "version": ">= 3.0.0"
    // [!code ++]
    "appVersionSource": "remote" // [!code ++]
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apk.pengwc.asia"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
