# 项目级 gitignore

# AI 辅助工具元数据
.omc/
.claude/

# 导出产物
/exports/

# 前端
/frontend/node_modules/
/frontend/dist/
/frontend/dist-electron/
/frontend/dist-renderer/
/frontend/.env
/frontend/.env.local

# 后端
/backend/__pycache__/
/backend/venv/
/backend/env/
/backend/.env
/backend/uploads/
/backend/outputs/
/backend/data/
/backend/licenses/
/backend/*.log

# 移动端
/mobile-app/node_modules/
/mobile-app/.expo/
/mobile-app/dist/

# 共享
/shared/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 测试
coverage/
.pytest_cache/

# 构建产物
*.egg-info/
__pycache__/
*.pyc
dist/

# 项目级上传/输出/数据目录
/uploads/
/outputs/
/data/
/全量工参/
/待规划小区/
/输出文件/

# 构建产物/运行时大文件（APK 安装包、分块上传临时文件、Playwright 浏览器）
/backend/app/apks/
/.playwright-cli/

# 依赖/构建缓存与临时文件
/node_modules/
/package.json
/package-lock.json
/.qwen/tmp/
*.bak
*.backup
mobile-app/$buildDir/
mobile-app/ninja-temp/
mobile-app/ninja-win.zip
mobile-app/android/ninja-fix/
mobile-app/build_log.txt
mobile-app/tsc_errors.txt

# 桌面端打包产物与授权密钥（私钥永不入库）
/build/
/desktop/build/
/desktop/dist/
/desktop/tools/*.pem
/desktop/tools/*.key
*.nptlic
